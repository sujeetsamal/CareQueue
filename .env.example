# ==============================================================================
# CareQueue Environment Configuration (Template / Example)
# Copy this file to .env for Docker or configure variables in your local environment.
# NEVER commit production passwords or secrets to source control.
# ==============================================================================

# Database Configuration (PostgreSQL)
POSTGRES_DB=carequeue_db
POSTGRES_USER=carequeue_user
POSTGRES_PASSWORD=carequeue_secret_dev
POSTGRES_PORT=5432

# Spring Boot Backend Configuration
SERVER_PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/carequeue_db
SPRING_DATASOURCE_USERNAME=carequeue_user
SPRING_DATASOURCE_PASSWORD=carequeue_secret_dev
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://carequeue.vercel.app

# Optional Seed Data for College Demo (true: populate fictional patients on start; false: production clean start)
CAREQUEUE_SEED_DEMO_DATA=true

# Frontend Configuration (Next.js)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api
